# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/premiumchef?schema=public"
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3000"
PORT=3001

# Auth
JWT_SECRET="replace-with-a-random-access-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-random-refresh-secret-at-least-32-characters"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App Ports
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
EXPO_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_DELIVERY_UNIT_ID=""

# Cloudflare R2 / S3 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="premiumchef-assets"
R2_PUBLIC_URL=""

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
